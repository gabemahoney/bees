FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.11 \
    python3.11-dev \
    python3.11-venv \
    python3-pip \
    pipx \
    curl \
    git \
    tmux \
    gosu \
    ca-certificates \
    gnupg \
    libffi-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Node 20
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Install Claude CLI
RUN npm install -g @anthropic-ai/claude-code

# Set python3.11 as default
RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1 \
    && update-alternatives --install /usr/bin/python python /usr/bin/python3.11 1

# Install bees from test.pypi (validates the full packaging pipeline)
# Retry up to 5 times with 30s backoff to handle test.pypi CDN propagation lag.
ARG BEES_VERSION
RUN pip install --no-cache-dir cffi \
    && for i in 1 2 3 4 5; do \
        pip install --no-cache-dir \
            --index-url https://test.pypi.org/simple/ \
            --extra-index-url https://pypi.org/simple/ \
            "bees-md[serve]==${BEES_VERSION}" && break \
        || { echo "Attempt $i failed, retrying in 30s..."; sleep 30; }; \
    done

# Copy skills and auto-approve script (no source mounted at runtime)
# Test plan is copied from the host testplans hive into /test-repo before Claude starts
COPY .claude/skills /test-repo/.claude/skills
COPY auto_approve.sh /usr/local/bin/auto_approve.sh
RUN chmod +x /usr/local/bin/auto_approve.sh

# Non-root user — simulates real user environment
RUN useradd -m -s /bin/bash testuser \
    && chown -R testuser:testuser /test-repo

WORKDIR /test-repo

COPY tests/integration.sh /test-repo/tests/
RUN chmod +x /test-repo/tests/integration.sh

COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
COPY docker/test_runner.sh /usr/local/bin/test_runner.sh
COPY docker/file_bug.py /usr/local/bin/file_bug.py
RUN chmod +x /usr/local/bin/entrypoint.sh /usr/local/bin/test_runner.sh

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
